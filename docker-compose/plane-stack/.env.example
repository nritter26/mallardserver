# ============================================================
# plane-stack environment (used by docker-compose.yaml)
#
# Local:     cp .env.example .env  and fill in the values
# Portainer: add the same variables under
#            Stacks -> plane-stack -> Environment variables
#            (or use "Load variables from .env file")
#
# Never commit the real .env file.
# Keep comments on their own lines: some loaders do not strip
# inline comments and would put them inside the value.
# Generate secrets with:  openssl rand -hex 32
#
# This stack creates its own plane-net and its own PostgreSQL,
# Valkey, RabbitMQ and MinIO. It needs nothing from data-stack.
# ============================================================

# --- Public address ---
# Used four times: APP_DOMAIN, WEB_URL, CORS_ALLOWED_ORIGINS
# and SITE_ADDRESS by extension. No scheme, host and port only.
# It must match the address you type into the browser, so with
# the published port that is:  192.168.1.121:8092
# Getting this wrong causes a CORS error and broken redirects.
PLANE_APP_DOMAIN=192.168.1.121:8092

# --- Image tag ---
# Every makeplane/* image reads this variable, so it pins the
# whole stack at once. Leaving it at "stable" means the next
# redeploy silently upgrades all fourteen containers.
PLANE_APP_RELEASE=stable

# --- Plane database ---
# Used in DATABASE_URL, the migrator and the api/worker services.
# Also set as POSTGRES_PASSWORD on the bundled plane-db.
#   openssl rand -hex 32
PLANE_DB_PASSWORD=change-me

# --- Django ---
# Signs sessions and API tokens.
#   openssl rand -hex 32
PLANE_SECRET_KEY=change-me

# --- Realtime collaboration ---
# Signs the live/websocket tokens.
#   openssl rand -hex 32
PLANE_LIVE_SERVER_SECRET_KEY=change-me

# --- Bundled RabbitMQ ---
# Used in AMQP_URL and as the RABBITMQ_DEFAULT_PASS of plane-mq.
#   openssl rand -hex 32
PLANE_RABBITMQ_PASSWORD=change-me

# --- Bundled MinIO ---
# Access key. The compose file defaults this to "planeminio"
# when the variable is empty, which is a poor default to keep.
#   openssl rand -hex 12
PLANE_MINIO_ACCESS_KEY=change-me
# Secret key. MinIO requires at least 8 characters. Very long
# values have caused startup failures in some Plane releases.
#   openssl rand -hex 32
PLANE_MINIO_SECRET_KEY=change-me