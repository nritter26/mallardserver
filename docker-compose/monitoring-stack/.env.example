# ============================================================
# monitoring-stack environment (used by docker-compose.yaml)
#
# Local:     cp .env.example .env  and fill in the values
# Portainer: add the same variables under
#            Stacks -> monitoring-stack -> Environment variables
#            (or use "Load variables from .env file")
#
# Never commit the real .env file.
# Keep comments on their own lines: some loaders do not strip
# inline comments and would put them inside the value.
# Generate secrets with:  openssl rand -hex 32
#
# This stack has two variables, both for the Grafana login.
# ============================================================

# --- Grafana ---
# Initial login. Grafana applies these on first start only;
# changing them here afterwards does not reset the stored admin.
GRAFANA_ADMIN_USER=change-me
GRAFANA_ADMIN_PASSWORD=change-me