# ============================================================
# auth-stack environment (used by docker-compose.yaml)
#
# Local:     cp .env.example .env  and fill in the values
# Portainer: add the same variables under
#            Stacks -> auth-stack -> Environment variables
#            (or use "Load variables from .env file")
#
# Never commit the real .env file.
# Keep comments on their own lines: some loaders do not strip
# inline comments and would put them inside the value.
# Generate secrets with:  openssl rand -base64 16
# ============================================================

# --- Keycloak bootstrap admin ---
# Applied ONLY when the keycloak database is empty, i.e. on the
# very first start. Once a master realm exists these are ignored,
# so changing them here does not reset the password.
# Change the password in the admin console after the first login.
KEYCLOAK_ADMIN=change-me
# openssl rand -base64 16
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- Shared PostgreSQL (data-stack) ---
# data-stack must already be deployed. Keycloak stores its state
# in the "keycloak" database on that server and does not create
# it, so create it first:
#   docker exec -it postgres psql -U <POSTGRES_USER> -c 'CREATE DATABASE keycloak;'
#
# These must match data-stack/.env exactly. This is the shared
# superuser, so Keycloak can reach every other database too.
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me