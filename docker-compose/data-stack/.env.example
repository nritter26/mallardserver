# ============================================================
# data-stack environment (used by docker-compose.yaml)
#
# Local:     cp .env.example .env  and fill in the values
# Portainer: add the same variables under
#            Stacks -> data-stack -> Environment variables
#            (or use "Load variables from .env file")
#
# Never commit the real .env file.
# Keep comments on their own lines: some loaders do not strip
# inline comments and would put them inside the value.
# Generate secrets with:  openssl rand -hex 32
#
# This compose file has no defaults for any variable. A missing
# name is substituted with an empty string and the service starts
# with blank or broken credentials.
# ============================================================

# --- Host ---
# Timezone used by PostgreSQL.
TZ=Europe/Berlin

# --- PostgreSQL ---
# Superuser for the shared postgres container.
# auth-stack, devops-stack and ai-stack connect with this same
# pair, so it must match the values in their own .env files.
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# --- pgAdmin (web client for postgres) ---
# Login for the UI only. Not used by any other stack.
PGADMIN_EMAIL=change-me
PGADMIN_PASSWORD=change-me

# --- MongoDB ---
# Root credentials. ai-stack (LibreChat) connects with this pair.
# openssl rand -hex 32
MONGO_USER=change-me
MONGO_PASSWORD=change-me

# --- mongo-express (web client for mongodb) ---
# Login for the UI only, independent of the MongoDB root user.
MONGO_EXPRESS_USER=change-me
MONGO_EXPRESS_PASSWORD=change-me

# --- Redis ---
# Passed as --requirepass on the command line.
# Use the same value when adding the connection in RedisInsight.
# openssl rand -hex 32
REDIS_PASSWORD=change-me

# --- RabbitMQ ---
# Default vhost user/pass, also the management UI login.
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me