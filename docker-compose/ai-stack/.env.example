# ============================================================
# ai-stack environment (used by docker-compose.yaml)
#
# Local:     cp .env.example .env  and fill in the values
# Portainer: add the same variables under
#            Stacks -> ai-stack -> Environment variables
#            (or use "Load variables from .env file")
#
# Never commit the real .env file.
# Keep comments on their own lines: some loaders do not strip
# inline comments and would put them inside the value.
#
# Not configurable through this file, because the compose file
# hardcodes them: DOMAIN_CLIENT, DOMAIN_SERVER (LibreChat),
# N8N_HOST and WEBHOOK_URL (n8n). All four point at 192.168.1.121.
# ============================================================

# --- Host ---
# Timezone used by n8n.
TZ=Europe/Berlin

# --- Shared MongoDB (data-stack) ---
# data-stack must already be deployed.
# LibreChat connects as the MongoDB root user to the "LibreChat"
# database with authSource=admin, so these must match data-stack/.env.
# openssl rand -hex 32
MONGO_USER=change-me
MONGO_PASSWORD=change-me

# --- Shared PostgreSQL (data-stack) ---
# data-stack must already be deployed. n8n also needs a database
# named "n8n" on that server; this stack does not create it:
#   docker exec -it postgres psql -U <POSTGRES_USER> -c 'CREATE DATABASE n8n;'
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# --- LibreChat secrets ---
# EXACT lengths matter; LibreChat refuses to start otherwise.
# Use hex encoding, not base64.
#
# CREDS_KEY: 256-bit key, 64 hex characters.
#   openssl rand -hex 32
LIBRECHAT_CREDS_KEY=change-me
# CREDS_IV: 128-bit key, 32 hex characters.
#   openssl rand -hex 16
LIBRECHAT_CREDS_IV=change-me
# JWT_SECRET: 64 hex characters.
#   openssl rand -hex 32
LIBRECHAT_JWT_SECRET=change-me
# JWT_REFRESH_SECRET: 64 hex characters, different from JWT_SECRET.
#   openssl rand -hex 32
LIBRECHAT_JWT_REFRESH_SECRET=change-me