# ============================================================
# dns-stack environment (used by docker-compose.yaml)
#
# Local:     cp .env.example .env  and fill in the values
# Portainer: add the same variables under
#            Stacks -> dns-stack -> Environment variables
#            (or use "Load variables from .env file")
#
# Never commit the real .env file.
# Keep comments on their own lines: some loaders do not strip
# inline comments and would put them inside the value.
# Generate secrets with:  openssl rand -hex 32
# ============================================================

# --- Host ---
# Timezone used by Pi-hole.
TZ=Europe/Berlin

# --- LAN address ---
# Used in: address=/mallard/${HOST_IP}
# Every <name>.mallard hostname resolves to this address, so it
# must be this host's own LAN IP.
# Check it with:  ip -4 addr show | grep inet
# Do not use 127.0.0.1 or a Docker bridge address here.
HOST_IP=192.168.1.121

# --- Pi-hole admin ---
# Password for the web interface at :8088 and pihole.mallard.
# Applied when the container initialises. Changing it later in
# this file does not change a password already stored in the
# pihole_etc volume; change it in the web interface instead.
PIHOLE_PASSWORD=change-me