# ============================================================
# sftp-stack environment (used by docker-compose.yaml)
#
# Local:     cp .env.example .env  and fill in the values
# Portainer: add the same variables under
#            Stacks -> sftp-stack -> Environment variables
#            (or use "Load variables from .env file")
#
# Never commit the real .env file.
# Keep comments on their own lines: some loaders do not strip
# inline comments and would put them inside the value.
#
# Not configurable through this file, because the compose file
# hardcodes them: the host path /data/ftp and host port 2224.
# ============================================================

# --- Login ---
# User name. It also names the home directory, which appears in
# the volume mount as /home/${SFTP_USER}/upload, so changing it
# later changes the mount target.
SFTP_USER=change-me
#   openssl rand -base64 18
# Applied only when the account is created. The password lives in
# the container filesystem, not a volume, so it is lost on
# recreate and restored from here. To change it on a running
# container use:  docker exec -it sftp passwd <SFTP_USER>
SFTP_PASSWORD=change-me

# --- File ownership on the host ---
# These must match the owner of /data/ftp on the host, or every
# upload fails with "Permission denied" even though login works.
#   sudo mkdir -p /data/ftp
#   sudo chown <SFTP_UID>:<SFTP_GID> /data/ftp
# Use an unprivileged user, never 0. 1000 is the first regular
# account on the host; confirm with:  getent passwd 1000
SFTP_UID=1000
SFTP_GID=1000