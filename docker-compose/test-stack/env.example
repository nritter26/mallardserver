# ============================================================
# dev-stack environment (used by docker-compose.yml)
#
# Local:     cp .env.example .env  and fill in the values
# Portainer: add the same variables under
#            Stacks -> dev-stack -> Environment variables
#            (or use "Load variables from .env file")
#
# Never commit the real .env file.
# Keep comments on their own lines: some loaders do not strip
# inline comments and would put them inside the value.
# Generate secrets with:  openssl rand -hex 32
# ============================================================

# --- Host / networking ---
# LAN IP or hostname you type in the browser to open Hoppscotch.
# Login breaks if this does not match the address you visit.
HOST=192.168.1.121

# External Docker networks (must already exist)
DEV_NETWORK=dev-net
# adjust to the network your data-stack uses
DATA_NETWORK=data-net

# --- Host ports ---
# 3000 is Grafana
HOPPSCOTCH_APP_PORT=3002
HOPPSCOTCH_ADMIN_PORT=3101
HOPPSCOTCH_BACKEND_PORT=3170
API_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# 8081 is mongo-express
SWAGGER_PORT=8082
PRISM_PORT=4010
K6_DASHBOARD_PORT=5665

# --- Shared PostgreSQL (data-stack) ---
POSTGRES_HOST=postgres
# container port, not the 5433 host port
POSTGRES_PORT=5432

HOPPSCOTCH_DB_NAME=hoppscotch
HOPPSCOTCH_DB_USER=hoppscotch
# must match CREATE USER hoppscotch WITH PASSWORD '...'
HOPPSCOTCH_DB_PASSWORD=change-me

APP_DB_NAME=app
APP_DB_USER=app
# must match CREATE USER app WITH PASSWORD '...'
APP_DB_PASSWORD=change-me

# --- Hoppscotch secrets ---
# openssl rand -hex 32
JWT_SECRET=change-me
# openssl rand -hex 32
SESSION_SECRET=change-me
# EXACTLY 32 characters: openssl rand -hex 16
DATA_ENCRYPTION_KEY=change-me

# --- Hoppscotch auth and mail ---
# Comma-separated: EMAIL,GITHUB,GOOGLE,MICROSOFT
VITE_ALLOWED_AUTH_PROVIDERS=EMAIL
MAILER_FROM=hoppscotch@mallard
MAILER_SMTP_URL=smtp://mailpit:1025
# set true only when served over HTTPS
ALLOW_SECURE_COOKIES=false

# --- Go API ---
APP_ENV=development
SMTP_ADDR=mailpit:1025
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=mallard-api

# --- Host paths (bind mounts) ---
DEV_SRC_PATH=/srv/dev/api
LOADTEST_PATH=/srv/dev/loadtests

# --- k6 ---
K6_WEB_DASHBOARD=true
