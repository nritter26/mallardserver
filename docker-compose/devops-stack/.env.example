# ============================================================
# devops-stack environment (used by docker-compose.yaml)
#
# Local:     cp .env.example .env  and fill in the values
# Portainer: add the same variables under
#            Stacks -> devops-stack -> Environment variables
#            (or use "Load variables from .env file")
#
# Never commit the real .env file.
# Keep comments on their own lines: some loaders do not strip
# inline comments and would put them inside the value.
# Generate secrets with:  openssl rand -hex 32
# ============================================================

# --- Host ---
# Timezone used by Gitea.
TZ=Europe/Berlin

# --- Shared PostgreSQL (data-stack) ---
# data-stack must already be deployed and these must match its
# .env exactly. Gitea also needs a database named "gitea" to
# exist on that server; this stack does not create it.
#   docker exec -it postgres psql -U <POSTGRES_USER> -c 'CREATE DATABASE gitea;'
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# --- Gitea Actions runner ---
# Registration token from Gitea:
#   Settings -> Actions -> Runners -> Add new runner
# It cannot be obtained before Gitea is running, so deploy once
# without it, then add the value here and update the stack.
# Generate one manually with:
#   docker run --rm gitea/act_runner:latest generate-jit
GITEA_RUNNER_TOKEN=